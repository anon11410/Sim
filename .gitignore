# GSD runtime state (per-machine, regenerated on demand)
.claude/gsd-install-state.json

# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
*.swp

# GSD research agent web-fetch cache (transient, per-machine)
.planning/research/.cache/

# GSD run-scoped runtime state (per-machine/per-session, regenerated on demand)
.gsd/
.planning/milestone.lock

# Rust build artefacts. Cargo.lock is deliberately NOT ignored -- it is part
# of the reproducibility contract (a minor bump of the RNG crate can legally
# change a distribution algorithm).
/target

# Run output. The binary's --out defaults to runs/latest, so a bare invocation
# in the repository root writes here. Generated per-run artefacts, never
# reviewed: the committed golden run of plan 03-06 lives under tests/, not here.
/runs
